; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Elsewhere"
config/description="A functional Linux desktop as a persistent first-person 3D environment."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.8", "Forward Plus")

[devtools]

editor_protocol=1

[display]

window/size/viewport_width=1280
window/size/viewport_height=800
window/size/mode=3
window/stretch/mode="disabled"

[rendering]

antialiasing/quality/msaa_3d=2

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="forward_plus"
rendering_device/fallback_to_opengl3=false
textures/streaming/enabled=true
textures/streaming/memory_budget_enabled=true
textures/streaming/memory_budget_mb=256
textures/streaming/min_lod=0
textures/streaming/max_lod=3
lights_and_shadows/contact_shadow/enabled=true
lights_and_shadows/multi_bounce_occlusion/enabled=true
environment/defaults/default_clear_color=Color(0.15, 0.15, 0.2, 1)
